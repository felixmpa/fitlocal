# Copia este archivo a .env y rellena tus valores.
# NUNCA subas el .env real al repositorio.

# --- Garmin Connect ---
GARMIN_EMAIL=tu-correo@ejemplo.com
GARMIN_PASSWORD=tu-contraseña

# --- Airtable (almacenamiento) ---
# Crea un Personal Access Token en https://airtable.com/create/tokens
# Scopes necesarios: data.records:read, data.records:write, schema.bases:write
AIRTABLE_TOKEN=pat...
# El ID de tu base (empieza por "app...") — lo ves en la URL de la base.
AIRTABLE_BASE_ID=app...

# --- Anthropic (agentes IA) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Configuración opcional ---
# Modelo por defecto para los agentes
FITLOCAL_MODEL=claude-opus-4-8
# Tu meta principal (la usan los agentes para enfocar las sugerencias)
FITLOCAL_GOAL=Perder grasa manteniendo masa muscular
